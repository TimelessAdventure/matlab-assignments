%BPSK
clc; clear all; close all;
x=randi([0, 1], 1, 10);
Eb=4; Tb=10;
fc=2;
fs=100;
t=0:1/fs:10-1/fs;
s1=sqrt(2*Eb/Tb)*cos(2*pi*fc.*t);
% BPSK Modulation
y = zeros(size(t));
for i = 1:length(x)
    y((i-1)*fs*Tb+1:i*fs*Tb) = sqrt(2*Eb/Tb) * cos(2*pi*fc*t((i-1)*fs*Tb+1:i*fs*Tb)) .* (2*x(i)-1);
end

subplot(211);
stairs(x);
ylim([-0.5 1.5]);
title("Binary Sequence");
subplot(212);
plot(t, y);
title("BPSK Modulated Signal");
